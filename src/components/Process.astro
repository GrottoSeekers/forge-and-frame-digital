---
const steps = [
  {
    n: "01",
    title: "Free website check",
    body: "Tell us about your business and (if you have one) your current site. We'll tell you honestly what's working, what isn't, and what we'd build.",
  },
  {
    n: "02",
    title: "Simple, fixed proposal",
    body: "One clear price, one clear timeline. No hidden extras, no hourly-rate guessing games.",
  },
  {
    n: "03",
    title: "We design & build",
    body: "You'll see drafts along the way and can ask for changes. We handle the copy, layout, and technical setup.",
  },
  {
    n: "04",
    title: "Launch & support",
    body: "We go live on your domain, hand over everything you need, and stay on hand for support or a care plan if you want one.",
  },
];
---

<section class="section" id="process">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">How it works</span>
      <h2>From "no website" to live, in about two weeks.</h2>
      <p>A simple, honest process — built for business owners who don't have time to manage a big project.</p>
    </div>

    <div class="process-list reveal-stagger">
      {steps.map((step, i) => (
        <div class="process-step">
          <div class="process-num">{step.n}</div>
          <div class="process-body">
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
          {i < steps.length - 1 && <div class="process-connector" aria-hidden="true"></div>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .process-step {
    position: relative;
    padding-top: 8px;
  }

  .process-num {
    font-family: "Fraunces", serif;
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .process-body h3 {
    font-size: 1.08rem;
    margin-bottom: 8px;
  }

  .process-body p {
    font-size: 0.92rem;
    color: var(--text-dim);
    margin: 0;
  }

  .process-connector {
    display: none;
  }

  @media (min-width: 901px) {
    .process-connector {
      display: block;
      position: absolute;
      top: 20px;
      left: calc(100% + 12px);
      width: calc(24px - 12px);
      height: 1px;
      background: var(--line-strong);
    }
  }

  @media (max-width: 900px) {
    .process-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .process-list {
      grid-template-columns: 1fr;
    }
  }
</style>
