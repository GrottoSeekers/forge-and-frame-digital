---
const base = import.meta.env.BASE_URL;

const navItems = [
  { href: "#services", label: "Services" },
  { href: "#process", label: "Process" },
  { href: "#pricing", label: "Pricing" },
  { href: "#work", label: "Work" },
  { href: "#faq", label: "FAQ" },
];
---

<header class="site-header">
  <div class="nav-pill">
    <a href={base} class="logo" aria-label="Forge & Frame home">
      <span class="logo-mark">F<span>&</span>F</span>
    </a>

    <nav class="nav" aria-label="Primary" id="primary-nav">
      <span class="nav-indicator" id="nav-indicator" aria-hidden="true"></span>
      {navItems.map((item, i) => (
        <a href={item.href} data-nav-link class={i === 0 ? "active" : ""}>{item.label}</a>
      ))}
    </nav>

    <a href="#contact" class="btn-cta">Get Started</a>

    <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" id="menu-toggle">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="nav-mobile" id="nav-mobile" aria-label="Mobile">
    {navItems.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
    <a href="#contact" class="btn-cta btn-cta--mobile">Get Started</a>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
  }

  .nav-pill {
    position: relative;
    display: flex;
    align-items: center;
    gap: 36px;
    padding: 10px 24px;
    border-radius: 9999px;
    background: rgba(2, 6, 23, 0.8);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-mark {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--on-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Fraunces", serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .logo-mark span {
    color: var(--on-accent);
    opacity: 0.65;
  }

  .nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav a {
    position: relative;
    z-index: 1;
    padding: 8px 14px;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .nav a:hover {
    color: #fff;
  }

  .nav a.active {
    color: #fff;
  }

  .nav-indicator {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    transform: translateX(0);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
    pointer-events: none;
  }

  .btn-cta {
    flex-shrink: 0;
    padding: 9px 20px;
    border-radius: 9999px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.3s var(--ease), box-shadow 0.3s ease;
  }

  .btn-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -10px rgba(255, 91, 46, 0.55);
  }

  .btn-cta--mobile {
    display: none;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: transparent;
    cursor: pointer;
    flex-shrink: 0;
  }

  .menu-toggle span {
    display: block;
    height: 2px;
    width: 16px;
    margin: 0 auto;
    background: #fff;
  }

  .nav-mobile {
    display: none;
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 220px;
    flex-direction: column;
    gap: 4px;
    padding: 14px;
    border-radius: 20px;
    background: rgba(2, 6, 23, 0.92);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .nav-mobile a {
    text-decoration: none;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 600;
    font-size: 0.92rem;
    padding: 10px 12px;
    border-radius: 12px;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .nav-mobile a:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .nav-mobile .btn-cta--mobile {
    display: block;
    text-align: center;
    margin-top: 6px;
  }

  .nav-mobile.open {
    display: flex;
  }

  @media (max-width: 800px) {
    .nav,
    .btn-cta {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
    .nav-pill {
      gap: 16px;
    }
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("nav-mobile");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });

  const nav = document.getElementById("primary-nav");
  const indicator = document.getElementById("nav-indicator") as HTMLElement | null;
  const links = Array.from(nav?.querySelectorAll<HTMLAnchorElement>("[data-nav-link]") ?? []);

  const sections = links
    .map((link) => document.querySelector<HTMLElement>(link.getAttribute("href") ?? ""))
    .filter((el): el is HTMLElement => Boolean(el));

  const moveIndicator = (link: HTMLAnchorElement) => {
    if (!indicator || !nav) return;
    const navRect = nav.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    indicator.style.width = `${linkRect.width}px`;
    indicator.style.transform = `translateX(${linkRect.left - navRect.left}px)`;
  };

  const setActive = (id: string) => {
    const activeLink = links.find((l) => l.getAttribute("href") === `#${id}`);
    if (!activeLink) return;
    links.forEach((l) => l.classList.toggle("active", l === activeLink));
    moveIndicator(activeLink);
  };

  const initIndicator = () => {
    const current = links.find((l) => l.classList.contains("active")) ?? links[0];
    if (current) moveIndicator(current);
  };

  requestAnimationFrame(initIndicator);
  window.addEventListener("load", initIndicator);
  window.addEventListener("resize", initIndicator);

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: "-45% 0px -45% 0px" }
  );

  sections.forEach((section) => observer.observe(section));
</script>
