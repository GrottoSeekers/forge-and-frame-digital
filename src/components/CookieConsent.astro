---
const base = import.meta.env.BASE_URL;
---

<div class="cookie-banner" id="cookie-banner" hidden role="dialog" aria-live="polite" aria-label="Cookie notice">
  <div class="wrap cookie-inner">
    <p>
      This site doesn't use tracking or advertising cookies — just your
      browser's local storage to remember this choice. See our
      <a href={`${base}/cookies-policy`}>Cookies Policy</a> for details.
    </p>
    <div class="cookie-actions">
      <button type="button" class="btn-cookie btn-cookie--ghost" id="cookie-decline">Decline</button>
      <button type="button" class="btn-cookie btn-cookie--accept" id="cookie-accept">Accept</button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    background: var(--text);
    color: var(--bg);
    padding: 18px 0;
    box-shadow: 0 -20px 40px -20px rgba(0, 0, 0, 0.35);
    transform: translateY(100%);
    transition: transform 0.4s var(--ease);
  }

  .cookie-banner.is-visible {
    transform: translateY(0);
  }

  .cookie-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .cookie-inner p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: rgba(251, 247, 239, 0.82);
    max-width: 640px;
  }

  .cookie-inner a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie-actions {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  .btn-cookie {
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    border: 1.5px solid transparent;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .btn-cookie:hover {
    transform: translateY(-2px);
  }

  .btn-cookie:active {
    transform: translateY(0) scale(0.96);
  }

  .btn-cookie--ghost {
    background: transparent;
    border-color: rgba(251, 247, 239, 0.3);
    color: #fff;
  }

  .btn-cookie--ghost:hover {
    border-color: rgba(251, 247, 239, 0.6);
  }

  .btn-cookie--accept {
    background: var(--accent);
    color: var(--on-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-banner {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .cookie-inner {
      flex-direction: column;
      align-items: stretch;
      text-align: left;
    }
    .cookie-actions {
      justify-content: flex-end;
    }
  }
</style>

<script>
  const STORAGE_KEY = "cg-cookie-consent";
  const banner = document.getElementById("cookie-banner");

  const hasConsented = (() => {
    try {
      return Boolean(localStorage.getItem(STORAGE_KEY));
    } catch {
      return true;
    }
  })();

  if (banner && !hasConsented) {
    banner.hidden = false;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => banner.classList.add("is-visible"));
    });
  }

  function recordChoice(choice: string) {
    try {
      localStorage.setItem(STORAGE_KEY, choice);
    } catch {
      // localStorage unavailable — nothing to persist, just dismiss
    }
    banner?.classList.remove("is-visible");
    banner?.addEventListener(
      "transitionend",
      () => {
        if (banner) banner.hidden = true;
      },
      { once: true }
    );
  }

  document.getElementById("cookie-accept")?.addEventListener("click", () => recordChoice("accepted"));
  document.getElementById("cookie-decline")?.addEventListener("click", () => recordChoice("declined"));
</script>
