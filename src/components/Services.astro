---
import Icon from "./Icon.astro";

const services = [
  {
    icon: "layout" as const,
    title: "New website builds",
    body: "A complete, custom website from scratch — home page, services, gallery, contact, the lot. Live in under a week, and ready for search from day one.",
    big: true,
  },
  {
    icon: "wrench" as const,
    title: "Website refresh & redesign",
    body: "Keep your domain and content where it makes sense, but with a modern design and a site that works on every phone.",
  },
  {
    icon: "shield-check" as const,
    title: "Care & hosting plans",
    body: "Ongoing hosting, security updates, and small content changes handled for you.",
  },
  {
    icon: "map-pin" as const,
    title: "Local search & Google Business setup",
    body: "We make sure your business actually shows up when local customers search nearby.",
    wide: true,
  },
];
---

<section class="section section-alt" id="services">
  <div class="orb orb-services" aria-hidden="true"></div>
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">What we do</span>
      <h2>Everything you need to be found online.</h2>
      <p>No jargon, no bloated packages — just what a growing local business actually needs.</p>
    </div>

    <div class="bento reveal-stagger">
      {services.map((service) => (
        <div
          class={`service-card ${service.big ? "service-card--big" : ""} ${service.wide ? "service-card--wide" : ""}`}
        >
          <div class="service-icon" aria-hidden="true">
            <Icon name={service.icon} />
          </div>
          <h3>{service.title}</h3>
          <p>{service.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-alt {
    position: relative;
    overflow: hidden;
  }

  .orb-services {
    width: 400px;
    height: 400px;
    background: var(--accent);
    top: 20%;
    right: -160px;
    opacity: 0.16;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .service-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 30px;
    transition: transform 0.4s var(--ease), border-color 0.3s ease, box-shadow 0.3s ease;
    grid-column: span 1;
  }

  .service-card:hover {
    transform: translateY(-6px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }

  .service-card--big,
  .service-card--wide {
    grid-column: span 2;
  }

  .service-card--big {
    background: linear-gradient(155deg, var(--bg-raised-2) 0%, var(--accent-soft) 55%, var(--bg) 100%);
    border-color: rgba(255, 91, 46, 0.25);
  }

  .service-card--big .service-icon {
    background: var(--accent);
    color: var(--on-accent);
  }

  .service-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--bg-raised-2);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }

  .service-card h3 {
    font-size: 1.15rem;
    margin-bottom: 8px;
  }

  .service-card p {
    font-size: 0.94rem;
    color: var(--text-dim);
    margin: 0;
  }

  @media (max-width: 900px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .service-card--big,
    .service-card--wide {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .bento {
      grid-template-columns: 1fr;
    }
    .service-card,
    .service-card--big,
    .service-card--wide {
      grid-column: auto;
    }
  }
</style>
