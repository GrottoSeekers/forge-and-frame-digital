---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="hero" id="hero">
  <div class="orb orb-a" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <div class="hero-copy stagger">
      <span class="eyebrow">Websites for local businesses</span>
      <h1>Online in <em>under a week.</em></h1>
      <p class="lead">
        We design and build fast, mobile-friendly websites for local
        businesses. You get a fixed price and a clear deadline before we
        start — no jargon, no surprises.
      </p>

      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">Get Your Free Website Check</a>
      </div>

      <ul class="hero-trust">
        <li>Delivered in under 7 days</li>
        <li>Fixed price upfront</li>
        <li>Mobile &amp; SEO ready</li>
      </ul>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="browser-frame">
        <div class="browser-bar">
          <span></span><span></span><span></span>
        </div>
        <div class="browser-body">
          <img
            src={`${base}/previews/trade-preview.jpg`}
            alt=""
            loading="eager"
            width="1120"
            height="680"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 112px 0 0;
    position: relative;
    overflow: hidden;
  }

  .orb {
    width: 480px;
    height: 480px;
  }

  .orb-a {
    background: var(--accent);
    top: -180px;
    right: -140px;
    opacity: 0.22;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 40px;
    align-items: center;
    padding-bottom: 112px;
  }

  h1 {
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    letter-spacing: -0.02em;
  }

  h1 em {
    font-style: italic;
    color: var(--accent-2);
  }

  .lead {
    font-size: 1.12rem;
    color: var(--text-dim);
    max-width: 500px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin: 30px 0 44px;
  }

  .hero-trust {
    display: flex;
    gap: 12px 28px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding-top: 26px;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-dim);
  }

  .hero-visual {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 460px;
    transform: rotate(1.5deg);
  }

  .browser-frame {
    background: var(--bg-raised);
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .browser-bar {
    display: flex;
    gap: 6px;
    padding: 14px 16px;
    background: var(--bg-raised-2);
  }

  .browser-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .browser-body {
    line-height: 0;
  }

  .browser-body img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      order: -1;
      justify-self: stretch;
      max-width: 100%;
      transform: none;
      margin-bottom: 24px;
    }
  }
</style>
