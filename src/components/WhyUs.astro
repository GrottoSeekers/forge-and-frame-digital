---
const metrics = [
  {
    label: "PageSpeed",
    bad: { value: 42, suffix: "/100" },
    good: { value: 100, suffix: "/100" },
  },
  {
    label: "Load time",
    bad: { value: 3.4, decimals: 1, suffix: "s" },
    good: { value: 0.3, decimals: 1, suffix: "s" },
  },
  {
    label: "Plugins vs. flaws",
    bad: { value: 85, suffix: "+" },
    good: { value: 0, suffix: "" },
  },
];
---

<section class="section section-compact" id="why-us">
  <div class="wrap">
    <div class="why-head reveal">
      <span class="eyebrow">Why us</span>
      <h2>Hand-coded beats bloated CMS builds.</h2>
    </div>

    <div class="stat-row reveal-stagger">
      {metrics.map((metric) => (
        <div class="stat-chip">
          <span class="stat-label">{metric.label}</span>
          <div class="stat-values">
            <span
              class="stat-value stat-value--bad"
              data-target={metric.bad.value}
              data-decimals={metric.bad.decimals ?? 0}
              data-suffix={metric.bad.suffix}
            >0</span>
            <svg class="stat-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            <span
              class="stat-value stat-value--good"
              data-target={metric.good.value}
              data-decimals={metric.good.decimals ?? 0}
              data-suffix={metric.good.suffix}
            >0</span>
          </div>
        </div>
      ))}
    </div>

    <p class="compare-footnote">Illustrative figures based on typical results — actual performance varies by site.</p>
  </div>
</section>

<style>
  .section-compact {
    padding: 64px 0;
  }

  .why-head {
    text-align: center;
    max-width: none;
    margin-bottom: 32px;
  }

  .why-head h2 {
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    margin: 0;
  }

  .why-head .eyebrow {
    justify-content: center;
    margin-bottom: 10px;
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 16px;
  }

  .stat-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 18px 14px;
    border-radius: var(--radius-sm);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    text-align: center;
  }

  .stat-label {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text-faint);
    text-transform: uppercase;
  }

  .stat-values {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .stat-value {
    font-family: "Fraunces", serif;
    font-weight: 600;
    font-size: 1.2rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .stat-value--bad {
    color: var(--error);
    opacity: 0.75;
  }

  .stat-value--good {
    color: var(--success);
  }

  .stat-arrow {
    width: 14px;
    height: 14px;
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .compare-footnote {
    margin: 0;
    text-align: center;
    font-size: 0.76rem;
    color: var(--text-faint);
  }

  @media (max-width: 640px) {
    .stat-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const formatValue = (value: number, decimals: number, suffix: string) =>
    `${value.toFixed(decimals)}${suffix}`;

  const animateCount = (el: HTMLElement) => {
    const target = parseFloat(el.dataset.target ?? "0");
    const decimals = parseInt(el.dataset.decimals ?? "0", 10);
    const suffix = el.dataset.suffix ?? "";

    if (prefersReducedMotion) {
      el.textContent = formatValue(target, decimals, suffix);
      return;
    }

    const duration = 1400;
    const startTime = performance.now();

    const tick = (now: number) => {
      const progress = Math.min((now - startTime) / duration, 1);
      const value = target * easeOutCubic(progress);
      el.textContent = formatValue(value, decimals, suffix);
      if (progress < 1) requestAnimationFrame(tick);
      else el.textContent = formatValue(target, decimals, suffix);
    };

    requestAnimationFrame(tick);
  };

  const section = document.getElementById("why-us");
  const values = Array.from(section?.querySelectorAll<HTMLElement>(".stat-value") ?? []);

  const observer = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          values.forEach((el) => animateCount(el));
          obs.disconnect();
        }
      });
    },
    { threshold: 0.35 }
  );

  if (section) observer.observe(section);
</script>
