---
const tiers = [
  {
    name: "Starter",
    price: "£XXX",
    tagline: "For businesses who just need to exist online, well.",
    features: [
      "Single-page site (home, about, services, contact)",
      "Mobile-friendly design",
      "Google Business Profile setup",
      "1 round of revisions",
    ],
    featured: false,
  },
  {
    name: "Growth",
    price: "£XXX",
    tagline: "The most popular choice for local businesses.",
    features: [
      "Multi-page site (up to 5 pages)",
      "Contact & enquiry forms",
      "Basic local SEO setup",
      "Photo gallery / portfolio section",
      "2 rounds of revisions",
    ],
    featured: true,
  },
  {
    name: "Custom",
    price: "Let's talk",
    tagline: "Bookings, online shops, multiple locations — bigger builds.",
    features: [
      "Everything in Growth",
      "Booking / ordering functionality",
      "Multi-location or multi-language support",
      "Ongoing care plan included",
    ],
    featured: false,
  },
];
---

<section class="section section-alt" id="pricing">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Pricing</span>
      <h2>Simple packages, fixed prices.</h2>
      <p>
        Every business is different, so these are starting points — your free
        website check ends with an exact quote, not a guess.
        <em>Prices shown are placeholders — set your own before launch.</em>
      </p>
    </div>

    <div class="grid grid-3 pricing-grid reveal-stagger">
      {tiers.map((tier) => (
        <div class={`card pricing-card ${tier.featured ? "featured" : ""}`}>
          {tier.featured && <span class="pill pricing-badge">Most popular</span>}
          <h3>{tier.name}</h3>
          <div class="pricing-amount">{tier.price}</div>
          <p class="pricing-tagline">{tier.tagline}</p>
          <ul>
            {tier.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
          <a href="#contact" class={`btn ${tier.featured ? "btn-primary" : "btn-ghost"} pricing-cta`}>
            Get started
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing-grid {
    align-items: center;
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .pricing-card.featured {
    border-color: var(--accent);
    box-shadow: var(--shadow);
    background: var(--bg-raised-2);
    transform: scale(1.05);
    z-index: 1;
  }

  .pricing-card.featured:hover {
    transform: scale(1.05) translateY(-4px);
  }

  .pricing-badge {
    position: absolute;
    top: -14px;
    left: 32px;
  }

  .pricing-amount {
    font-family: "Fraunces", serif;
    font-size: 2.3rem;
    font-weight: 600;
    margin: 12px 0 4px;
  }

  .pricing-tagline {
    color: var(--text-dim);
    font-size: 0.92rem;
  }

  .pricing-card ul {
    list-style: none;
    padding: 0;
    margin: 20px 0 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .pricing-card li {
    padding-left: 24px;
    position: relative;
    font-size: 0.92rem;
    color: var(--text-dim);
  }

  .pricing-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent-2);
    font-weight: 700;
  }

  .pricing-cta {
    width: 100%;
  }

  @media (max-width: 900px) {
    .pricing-card.featured {
      transform: none;
    }
    .pricing-card.featured:hover {
      transform: translateY(-4px);
    }
  }
</style>
