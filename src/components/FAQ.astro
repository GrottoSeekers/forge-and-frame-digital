---
import Icon from "./Icon.astro";

export const faqs = [
  {
    q: "How long does it take?",
    a: "Under a week once we have your details, photos and go-ahead.",
  },
  {
    q: "Do I own the site?",
    a: "Yes — 100% yours on final payment, on your own domain.",
  },
  {
    q: "What if I don't have photos or text?",
    a: "We write the copy and source the images for you. It's included in every package.",
  },
  {
    q: "Can I make changes after launch?",
    a: "Send us what you'd like changed and we'll quote it, or it's included on the $60/month maintenance plan.",
  },
  {
    q: "Do you handle domains and hosting?",
    a: "Yes — we register domains at cost, or build on the domain and hosting you already have.",
  },
  {
    q: "Do you only work with Australian businesses?",
    a: "No. We're based in Sydney and most of our clients are Australian, but the whole process is remote — brief, drafts, feedback and launch all happen over WhatsApp, email and video. We've set up hours that overlap with the UK, US and Europe, and we invoice in your local currency.",
  },
];
---

<section class="section section-alt" id="faq">
  <div class="wrap faq-wrap">
    <div class="faq-intro reveal">
      <span class="eyebrow">FAQ</span>
      <h2>Good questions, honest answers.</h2>
      <p>Anything else, just ask — we answer WhatsApp faster than email.</p>
      <a href="#contact" class="arrow-link">
        Ask a question
        <Icon name="arrow-right" class="arrow-link-icon" />
      </a>
    </div>

    <div class="faq-list reveal">
      {faqs.map((item, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>
            <span class="faq-q">{item.q}</span>
            <span class="faq-icon" aria-hidden="true">
              <Icon name="chevron-down" />
            </span>
          </summary>
          <div class="faq-panel">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-wrap {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .faq-intro p {
    color: var(--text-dim);
    margin: 0 0 20px;
  }

  .arrow-link-icon {
    width: 15px;
    height: 15px;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-bottom: 1px solid rgba(28, 23, 16, 0.14);
  }

  .faq-item summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 60px;
    padding: 16px 0;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-family: "Fraunces", serif;
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .faq-icon {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1.5px solid rgba(28, 23, 16, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-2);
    transition: transform 0.3s var(--ease);
  }

  .faq-icon svg {
    width: 15px;
    height: 15px;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-panel {
    overflow: hidden;
  }

  .faq-panel p {
    margin: 0 0 18px;
    color: rgba(28, 23, 16, 0.72);
    font-size: 0.94rem;
    max-width: 60ch;
  }
</style>

<script>
  import { animate } from "motion";
  import { prefersReducedMotion } from "../lib/motion-utils.js";

  const EASE = [0.22, 1, 0.36, 1];

  document.querySelectorAll(".faq-item").forEach((details) => {
    const summary = details.querySelector("summary");
    const panel = details.querySelector(".faq-panel");
    if (!(details instanceof HTMLDetailsElement) || !summary || !(panel instanceof HTMLElement)) return;

    let isAnimating = false;

    summary.addEventListener("click", (event) => {
      event.preventDefault();
      if (isAnimating) return;
      details.open ? closePanel() : openPanel();
    });

    function openPanel() {
      details.open = true;

      if (prefersReducedMotion()) {
        panel.style.removeProperty("height");
        panel.style.removeProperty("opacity");
        return;
      }

      isAnimating = true;
      const targetHeight = panel.scrollHeight;
      animate(panel, { height: [0, `${targetHeight}px`], opacity: [0, 1] }, { duration: 0.35, ease: EASE })
        .then(() => {
          panel.style.removeProperty("height");
          panel.style.removeProperty("opacity");
          isAnimating = false;
        });
    }

    function closePanel() {
      if (prefersReducedMotion()) {
        details.open = false;
        return;
      }

      isAnimating = true;
      const startHeight = panel.scrollHeight;
      panel.style.height = `${startHeight}px`;

      requestAnimationFrame(() => {
        animate(panel, { height: [`${startHeight}px`, "0px"], opacity: [1, 0] }, { duration: 0.3, ease: EASE })
          .then(() => {
            details.open = false;
            panel.style.removeProperty("height");
            panel.style.removeProperty("opacity");
            isAnimating = false;
          });
      });
    }
  });
</script>
