---
const faqs = [
  {
    q: "How long does it take?",
    a: "Under a week once we have your details.",
  },
  {
    q: "Do I own the site?",
    a: "Yes, 100% yours upon final payment.",
  },
  {
    q: "What if I don't have photos or text?",
    a: "We write the text and source images for you.",
  },
  {
    q: "How much does it cost?",
    a: "It depends on what you need. Use the estimate tool above, or ask us for a fixed quote.",
  },
  {
    q: "Can I update the site myself later?",
    a: "Yes. We'll show you how, or you can add our maintenance plan and we'll handle it.",
  },
  {
    q: "Do you handle my domain and hosting?",
    a: "Yes — or we can build on your existing domain and hosting if you'd rather keep it.",
  },
  {
    q: "What if I want changes after the site is live?",
    a: "Small text and image changes are quick to make. For ongoing updates, our maintenance plan covers it.",
  },
  {
    q: "Do you only work with businesses in the UK?",
    a: "No. We're UK-based but work with businesses anywhere — everything is done remotely.",
  },
];
---

<section class="section" id="faq">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">FAQ</span>
      <h2>Good questions, honest answers.</h2>
    </div>

    <div class="faq-list reveal">
      {faqs.map((item, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>
            <span class="faq-q">{item.q}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <div class="faq-panel">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    max-width: 780px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
    padding: 22px 0;
  }

  .faq-item summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-family: "Fraunces", serif;
    font-weight: 600;
    font-size: 1.08rem;
  }

  .faq-icon {
    position: relative;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    background: var(--accent-2);
    transition: transform 0.3s var(--ease);
  }

  .faq-icon::before {
    left: 0;
    top: 9px;
    width: 20px;
    height: 2px;
  }

  .faq-icon::after {
    left: 9px;
    top: 0;
    width: 2px;
    height: 20px;
  }

  .faq-item[open] .faq-icon::after {
    transform: rotate(90deg) scaleX(0);
  }

  .faq-panel {
    overflow: hidden;
  }

  .faq-panel p {
    margin: 14px 0 0;
    color: var(--text-dim);
    max-width: 620px;
  }
</style>

<script>
  import { animate } from "motion";
  import { prefersReducedMotion } from "../lib/motion-utils.js";

  const EASE = [0.22, 1, 0.36, 1];

  document.querySelectorAll(".faq-item").forEach((details) => {
    const summary = details.querySelector("summary");
    const panel = details.querySelector(".faq-panel");
    if (!(details instanceof HTMLDetailsElement) || !summary || !(panel instanceof HTMLElement)) return;

    let isAnimating = false;

    summary.addEventListener("click", (event) => {
      event.preventDefault();
      if (isAnimating) return;
      details.open ? closePanel() : openPanel();
    });

    function openPanel() {
      details.open = true;

      if (prefersReducedMotion()) {
        panel.style.removeProperty("height");
        panel.style.removeProperty("opacity");
        return;
      }

      isAnimating = true;
      const targetHeight = panel.scrollHeight;
      animate(panel, { height: [0, `${targetHeight}px`], opacity: [0, 1] }, { duration: 0.35, ease: EASE })
        .then(() => {
          panel.style.removeProperty("height");
          panel.style.removeProperty("opacity");
          isAnimating = false;
        });
    }

    function closePanel() {
      if (prefersReducedMotion()) {
        details.open = false;
        return;
      }

      isAnimating = true;
      const startHeight = panel.scrollHeight;
      panel.style.height = `${startHeight}px`;

      requestAnimationFrame(() => {
        animate(panel, { height: [`${startHeight}px`, "0px"], opacity: [1, 0] }, { duration: 0.3, ease: EASE })
          .then(() => {
            details.open = false;
            panel.style.removeProperty("height");
            panel.style.removeProperty("opacity");
            isAnimating = false;
          });
      });
    }
  });
</script>
