---
const faqs = [
  {
    q: "I don't have any content or photos yet — is that a problem?",
    a: "Not at all. We'll guide you on what's needed and can help write the copy and source suitable images so you don't have to start from a blank page.",
  },
  {
    q: "Will I be able to update the site myself afterwards?",
    a: "Yes — we build sites so simple text and image changes can be made without touching code. If you'd rather not, our care plan covers changes for you.",
  },
  {
    q: "Do I own the website?",
    a: "Yes. Once the final payment is made, the site and its domain (if we register it for you) are entirely yours.",
  },
  {
    q: "How long does a typical project take?",
    a: "Most single or multi-page sites go from kickoff to launch in under a week, depending on how quickly we get content and feedback from you.",
  },
  {
    q: "Do you only work with businesses in the UK?",
    a: "We're starting out focused on the UK, but everything we do is remote — so we're happy to work with businesses anywhere.",
  },
];
---

<section class="section" id="faq">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">FAQ</span>
      <h2>Good questions, honest answers.</h2>
    </div>

    <div class="faq-list reveal">
      {faqs.map((item, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>
            <span class="faq-q">{item.q}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    max-width: 780px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
    padding: 22px 0;
  }

  .faq-item summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-family: "Fraunces", serif;
    font-weight: 600;
    font-size: 1.08rem;
  }

  .faq-icon {
    position: relative;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    background: var(--accent-2);
    transition: transform 0.3s var(--ease);
  }

  .faq-icon::before {
    left: 0;
    top: 9px;
    width: 20px;
    height: 2px;
  }

  .faq-icon::after {
    left: 9px;
    top: 0;
    width: 2px;
    height: 20px;
  }

  .faq-item[open] .faq-icon::after {
    transform: rotate(90deg) scaleX(0);
  }

  .faq-item p {
    margin: 14px 0 0;
    color: var(--text-dim);
    max-width: 620px;
  }
</style>
