---
import Icon from "./Icon.astro";

const services = [
  { icon: "layout" as const, title: "New Builds", body: "Custom-built websites ready to generate local leads." },
  { icon: "wrench" as const, title: "Redesigns", body: "Modernize your existing site on your current domain." },
  { icon: "map-pin" as const, title: "Local SEO", body: "Setup and tuning so local customers find you on Google." },
  { icon: "shield-check" as const, title: "Maintenance & Hosting", body: "Site updates, security, and hosting managed for you." },
];
---

<section class="section section-alt" id="services">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Services</span>
      <h2>What we do.</h2>
    </div>

    <div class="services-row reveal-stagger">
      {services.map((service) => (
        <div class="service-item">
          <div class="service-icon" aria-hidden="true">
            <Icon name={service.icon} />
          </div>
          <h4>{service.title}</h4>
          <p>{service.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .service-item {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px;
    transition: border-color 0.3s ease;
  }

  .service-item:hover {
    border-color: var(--line-strong);
  }

  .services-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .service-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--bg-raised-2);
    color: var(--accent-text);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }

  .service-icon :global(svg) {
    width: 18px;
    height: 18px;
  }

  .service-item h4 {
    font-family: "Fraunces", serif;
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 6px;
  }

  .service-item p {
    font-size: 0.86rem;
    color: var(--text-dim);
    margin: 0;
  }

  @media (max-width: 900px) {
    .services-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .services-row {
      grid-template-columns: 1fr;
    }
  }
</style>
