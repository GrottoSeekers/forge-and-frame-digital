---
import Logomark from "./Logomark.astro";

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <a href={base} class="logo">
      <Logomark class="logo-mark" color="var(--accent-text)" />
      <span class="logo-word">CG Design <span class="amp">&amp;</span> Co.</span>
    </a>

    <nav class="footer-nav" aria-label="Footer">
      <a href="#services">Services</a>
      <a href="#pricing">Pricing</a>
      <a href="#work">Work</a>
      <a href="#faq">FAQ</a>
      <a href="#contact">Contact</a>
    </nav>

    <nav class="footer-nav footer-nav--legal" aria-label="Legal">
      <a href={`${base}/privacy-policy`}>Privacy Policy</a>
      <a href={`${base}/terms-and-conditions`}>Terms &amp; Conditions</a>
      <a href={`${base}/cookies-policy`}>Cookies Policy</a>
      <a href={`${base}/refund-policy`}>Refund Policy</a>
    </nav>

    <p class="footer-copy">© {year} CG Design &amp; Co. Websites for local businesses, everywhere.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: 48px 0 36px;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    text-align: center;
  }

  .footer-nav {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 0.88rem;
  }

  .footer-nav a {
    text-decoration: none;
    color: var(--text-dim);
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: var(--accent-2);
  }

  .footer-nav--legal {
    font-size: 0.78rem;
  }

  .footer-nav--legal a {
    color: var(--text-faint);
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--text-faint);
    margin: 0;
  }
</style>
