---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <a href={base} class="logo logo--light">
      <span class="logo-mark">F<span>&</span>F</span>
      <span class="logo-word">Forge<span class="amp">&amp;</span>Frame</span>
    </a>

    <nav class="footer-nav" aria-label="Footer">
      <a href="#services">Services</a>
      <a href="#pricing">Pricing</a>
      <a href="#work">Work</a>
      <a href="#faq">FAQ</a>
      <a href="#contact">Contact</a>
    </nav>

    <p class="footer-copy">© {year} Forge & Frame Digital. Websites for local businesses, everywhere.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: rgba(251, 248, 242, 0.7);
    padding: 40px 0 32px;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .footer-nav {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 0.88rem;
  }

  .footer-nav a {
    text-decoration: none;
    color: rgba(251, 248, 242, 0.7);
  }

  .footer-nav a:hover {
    color: var(--paper);
  }

  .footer-copy {
    font-size: 0.8rem;
    color: rgba(251, 248, 242, 0.45);
    margin: 0;
  }
</style>
