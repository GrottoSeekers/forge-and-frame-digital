---
---

<section class="section section-alt" id="about">
  <div class="wrap about-wrap">
    <div class="about-copy reveal">
      <span class="eyebrow">About</span>
      <h2>Who we are.</h2>
      <p>
        We build straightforward, fast websites for local businesses. You
        deal directly with the designer, get a fixed price before work
        starts, and get a site that actually brings in clients.
      </p>
    </div>

    <div class="about-stats reveal-stagger">
      <div class="stat">
        <strong>UK-based</strong>
        <span>remote-friendly, worldwide</span>
      </div>
      <div class="stat">
        <strong>1 point of contact</strong>
        <span>talk directly to your designer</span>
      </div>
      <div class="stat">
        <strong>Fixed pricing</strong>
        <span>agreed before work starts</span>
      </div>
    </div>
  </div>
</section>

<style>
  .about-wrap {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .about-copy p {
    color: var(--text-dim);
    font-size: 1.02rem;
  }

  .about-stats {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .stat {
    border-left: 2px solid var(--accent);
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat strong {
    font-family: "Fraunces", serif;
    font-size: 1.08rem;
    font-weight: 600;
  }

  .stat span {
    font-size: 0.86rem;
    color: var(--text-faint);
  }

  @media (max-width: 800px) {
    .about-wrap {
      grid-template-columns: 1fr;
    }
  }
</style>
