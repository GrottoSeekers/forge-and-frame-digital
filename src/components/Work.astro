---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const concepts = [
  {
    tag: "Trade & Services Concept",
    business: "Apex Heating & Electrical",
    preview: `${base}/previews/trade-preview.jpg`,
    href: `${base}/demo-trade.html`,
    features: ["Tap-to-call enabled", "24/7 emergency badge", "0.6s load speed"],
    businessType: "Trade & Services",
  },
  {
    tag: "Café & Restaurant Concept",
    business: "The Artisan Kitchen",
    preview: `${base}/previews/cafe-preview.jpg`,
    href: `${base}/demo-cafe.html`,
    features: ["Live open/closed status", "Tabbed menu system", "Instant table booking"],
    businessType: "Café & Restaurant",
  },
  {
    tag: "Salon & Wellness Concept",
    business: "Aura Skin & Beauty",
    preview: `${base}/previews/salon-preview.jpg`,
    href: `${base}/demo-salon.html`,
    features: ["Sticky booking bar", "Visual pricing menu", "Client review slider"],
    businessType: "Salon & Wellness",
  },
];
---

<section class="section" id="work">
  <div class="wrap work-wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Our work</span>
      <h2>No client sites yet — here's what we'd build you.</h2>
      <p>
        We're a new studio, so there's no real portfolio to show off yet.
        Instead, here are three live concept builds — the kind of site
        we'd design for a business like yours, ready to go live in under
        a week.
      </p>
    </div>

    <div class="concept-grid reveal-stagger">
      {concepts.map((concept) => (
        <div class="concept-card">
          <div class="preview-frame">
            <div class="browser-bar">
              <span></span><span></span><span></span>
            </div>
            <div class="preview-image-wrap">
              <img
                src={concept.preview}
                alt={`${concept.business} homepage preview`}
                loading="lazy"
                width="1120"
                height="680"
              />
              <div class="device-badges">
                <span class="device-badge">
                  <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                  Desktop
                </span>
                <span class="device-badge">
                  <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>
                  Mobile
                </span>
              </div>
            </div>
          </div>

          <span class="pill concept-tag">{concept.tag}</span>

          <ul class="feature-tags">
            {concept.features.map((feature) => (
              <li>
                <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                {feature}
              </li>
            ))}
          </ul>

          <div class="concept-ctas">
            <a href={concept.href} target="_blank" rel="noopener" class="btn btn-primary concept-cta-primary">
              View Live Demo
              <svg class="cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
            </a>
            <button type="button" class="btn btn-ghost concept-cta-secondary" data-business-type={concept.businessType}>
              Want a site like this?
            </button>
          </div>
        </div>
      ))}
    </div>

    <div class="founding-note reveal">
      <p>
        Like the direction? The first businesses we work with get priority
        turnaround and founder pricing — and a real say in how it turns out.
      </p>
      <a href="#contact" class="btn btn-primary">Become a founding client</a>
    </div>
  </div>
</section>

<style>
  .concept-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 48px;
  }

  .concept-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .preview-frame {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .browser-bar {
    background: #0f172a;
    padding: 8px;
    display: flex;
    gap: 6px;
  }

  .browser-bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
  }

  .browser-bar span:first-child { background: #ff5f56; }
  .browser-bar span:nth-child(2) { background: #ffbd2e; }
  .browser-bar span:nth-child(3) { background: #27c93f; }

  .preview-image-wrap {
    position: relative;
    line-height: 0;
  }

  .preview-image-wrap img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.5s var(--ease);
  }

  .concept-card:hover .preview-image-wrap img {
    transform: scale(1.03);
  }

  .device-badges {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: flex;
    gap: 6px;
  }

  .device-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(11, 14, 20, 0.72);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 5px 10px;
    border-radius: 999px;
  }

  .badge-icon { width: 12px; height: 12px; }

  .concept-tag { align-self: flex-start; }

  .feature-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .feature-tags li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--text-dim);
  }

  .feature-icon {
    width: 15px;
    height: 15px;
    color: var(--accent-2);
    flex-shrink: 0;
  }

  .concept-ctas {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .concept-cta-primary {
    width: 100%;
  }

  .cta-icon {
    width: 15px;
    height: 15px;
  }

  .concept-cta-secondary {
    width: 100%;
    font-size: 0.86rem;
  }

  .founding-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: 32px;
  }

  .founding-note p {
    margin: 0;
    color: var(--text-dim);
    max-width: 480px;
  }

  @media (max-width: 900px) {
    .concept-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".concept-cta-secondary").forEach((btn) => {
    btn.addEventListener("click", () => {
      const businessType = btn.dataset.businessType || "";

      const notice = document.getElementById("prefill-notice");
      const typeEl = document.getElementById("prefill-type");
      const serviceSelect = document.getElementById("service") as HTMLSelectElement | null;
      const businessNameInput = document.getElementById("business_name") as HTMLInputElement | null;

      if (typeEl) typeEl.textContent = businessType;
      if (notice) notice.hidden = false;

      if (serviceSelect) {
        serviceSelect.value = "New Site";
        serviceSelect.dispatchEvent(new Event("change"));
      }

      document.getElementById("contact")?.scrollIntoView({ behavior: "smooth", block: "start" });

      if (businessNameInput && !businessNameInput.value) {
        window.setTimeout(() => businessNameInput.focus(), 500);
      }
    });
  });
</script>
