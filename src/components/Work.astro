---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const concepts = [
  {
    tag: "Trade & Services Concept",
    business: "Apex Heating & Electrical",
    domain: "apexheating.co.uk",
    previewDesktop: `${base}/previews/trade-preview.jpg`,
    previewMobile: `${base}/previews/trade-preview-mobile.jpg`,
    href: `${base}/demo-trade.html`,
    features: ["Tap-to-Call", "24/7 Badge", "0.6s Load"],
    businessType: "Trade & Services",
  },
  {
    tag: "Café & Restaurant Concept",
    business: "The Artisan Kitchen",
    domain: "theartisankitchen.co.uk",
    previewDesktop: `${base}/previews/cafe-preview.jpg`,
    previewMobile: `${base}/previews/cafe-preview-mobile.jpg`,
    href: `${base}/demo-cafe.html`,
    features: ["Live Status", "Tabbed Menu", "Instant Booking"],
    businessType: "Café & Restaurant",
  },
  {
    tag: "Salon & Wellness Concept",
    business: "Aura Skin & Beauty",
    domain: "auraskinbeauty.co.uk",
    previewDesktop: `${base}/previews/salon-preview.jpg`,
    previewMobile: `${base}/previews/salon-preview-mobile.jpg`,
    href: `${base}/demo-salon.html`,
    features: ["Sticky Booking", "Visual Pricing", "SEO Optimized"],
    businessType: "Salon & Wellness",
  },
];
---

<section class="section" id="work">
  <div class="wrap work-wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Our work</span>
      <h2>No client sites yet — here's what we'd build you.</h2>
      <p>
        We're a new studio, so there's no real portfolio to show off yet.
        Here's one of the concept builds we'd design for a business like
        yours — flick through to see the others.
      </p>
    </div>

    <div class="concept-carousel reveal" id="concept-carousel">
      <button type="button" class="carousel-arrow carousel-arrow--prev" id="concept-prev" aria-label="Previous concept">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <div class="concept-viewport">
        <div class="concept-track" id="concept-track">
          {concepts.map((concept) => (
            <div class="concept-slide">
              <div class="concept-card">
                <div class="preview-frame" data-preview-frame>
                  <div class="browser-bar">
                    <div class="traffic-lights">
                      <span></span><span></span><span></span>
                    </div>
                    <div class="url-bar">
                      <svg class="url-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                      <span>{concept.domain}</span>
                    </div>
                    <div class="viewport-toggle" role="group" aria-label={`${concept.business} preview viewport`}>
                      <button type="button" class="viewport-btn is-active" data-mode="desktop" aria-pressed="true" aria-label="Desktop preview">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                      </button>
                      <button type="button" class="viewport-btn" data-mode="mobile" aria-pressed="false" aria-label="Mobile preview">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>
                      </button>
                    </div>
                  </div>
                  <div class="preview-image-wrap">
                    <img
                      src={concept.previewDesktop}
                      alt={`${concept.business} homepage preview, desktop view`}
                      width="1120"
                      height="680"
                      data-mode="desktop"
                    />
                    <img
                      src={concept.previewMobile}
                      alt={`${concept.business} homepage preview, mobile view`}
                      width="430"
                      height="932"
                      data-mode="mobile"
                    />
                  </div>
                </div>

                <span class="pill concept-tag">{concept.tag}</span>

                <ul class="tag-row">
                  {concept.features.map((feature) => (
                    <li class="tag-pill">
                      <svg class="tag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      {feature}
                    </li>
                  ))}
                </ul>

                <div class="concept-ctas">
                  <a href={concept.href} target="_blank" rel="noopener" class="btn btn-primary concept-cta-primary">
                    View Demo
                    <svg class="cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
                  </a>
                  <button type="button" class="btn btn-ghost concept-cta-secondary" data-business-type={concept.businessType}>
                    Want a site like this?
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <button type="button" class="carousel-arrow carousel-arrow--next" id="concept-next" aria-label="Next concept">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>

    <div class="concept-dots" id="concept-dots" role="tablist" aria-label="Choose a concept">
      {concepts.map((concept, i) => (
        <button
          type="button"
          class="concept-dot"
          data-index={i}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-label={`Show ${concept.business} concept`}
        ></button>
      ))}
    </div>

    <div class="founding-note reveal">
      <p>
        Like the direction? The first businesses we work with get priority
        turnaround and founder pricing — and a real say in how it turns out.
      </p>
      <a href="#contact" class="btn btn-primary">Become a founding client</a>
    </div>
  </div>
</section>

<style>
  .concept-carousel {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  .carousel-arrow {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--line-strong);
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: var(--shadow);
    transition: border-color 0.25s ease, color 0.25s ease, transform 0.25s var(--ease);
  }

  .carousel-arrow:hover {
    border-color: var(--accent-2);
    color: var(--accent-2);
  }

  .carousel-arrow:active {
    transform: scale(0.94);
  }

  .carousel-arrow svg {
    width: 18px;
    height: 18px;
  }

  .concept-viewport {
    flex: 1;
    max-width: 640px;
    margin: 0 auto;
    overflow: hidden;
  }

  .concept-track {
    display: flex;
    transition: transform 0.5s var(--ease);
  }

  .concept-slide {
    flex: 0 0 100%;
    width: 100%;
  }

  .concept-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .preview-frame {
    max-width: 100%;
    margin: 0 auto;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    background: #0f172a;
    transition: max-width 0.45s var(--ease);
  }

  .preview-frame.is-mobile-view {
    max-width: 240px;
  }

  .browser-bar {
    background: #0f172a;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .traffic-lights {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .traffic-lights span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
  }

  .traffic-lights span:nth-child(1) { background: #ff5f56; }
  .traffic-lights span:nth-child(2) { background: #ffbd2e; }
  .traffic-lights span:nth-child(3) { background: #27c93f; }

  .url-bar {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    padding: 4px 10px;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.7rem;
    font-family: "Plus Jakarta Sans", sans-serif;
  }

  .url-bar span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .url-lock {
    width: 11px;
    height: 11px;
    flex-shrink: 0;
    color: var(--accent-2);
  }

  .viewport-toggle {
    flex-shrink: 0;
    display: flex;
    gap: 2px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 999px;
    padding: 2px;
  }

  .viewport-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .viewport-btn svg {
    width: 12px;
    height: 12px;
  }

  .viewport-btn:hover {
    color: rgba(255, 255, 255, 0.8);
  }

  .viewport-btn.is-active {
    background: var(--accent);
    color: var(--on-accent);
  }

  .preview-image-wrap {
    position: relative;
    line-height: 0;
  }

  .preview-image-wrap img {
    width: 100%;
    height: auto;
    display: block;
    transition: opacity 0.3s ease;
  }

  .preview-image-wrap img[data-mode="mobile"] {
    display: none;
  }

  .preview-frame.is-mobile-view .preview-image-wrap img[data-mode="desktop"] {
    display: none;
  }

  .preview-frame.is-mobile-view .preview-image-wrap img[data-mode="mobile"] {
    display: block;
  }

  .concept-tag { align-self: flex-start; }

  .tag-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-dim);
    transition: transform 0.25s var(--ease), border-color 0.25s ease, color 0.25s ease, background 0.25s ease;
  }

  .tag-pill:hover {
    transform: translateY(-2px);
    border-color: var(--accent-2);
    color: var(--accent-2);
    background: var(--accent-2-soft);
  }

  .tag-icon {
    width: 13px;
    height: 13px;
    color: var(--accent-2);
    flex-shrink: 0;
  }

  .concept-ctas {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .concept-cta-primary {
    width: 100%;
  }

  .cta-icon {
    width: 15px;
    height: 15px;
  }

  .concept-cta-secondary {
    width: 100%;
    font-size: 0.86rem;
  }

  .concept-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 48px;
  }

  .concept-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .concept-dot:hover {
    background: var(--accent-2);
  }

  .concept-dot[aria-selected="true"] {
    background: var(--accent);
    transform: scale(1.3);
  }

  .founding-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: 32px;
  }

  .founding-note p {
    margin: 0;
    color: var(--text-dim);
    max-width: 480px;
  }

  @media (max-width: 640px) {
    .concept-carousel {
      gap: 10px;
    }
    .carousel-arrow {
      width: 38px;
      height: 38px;
    }
    .url-bar span {
      max-width: 90px;
    }
  }
</style>

<script>
  const track = document.getElementById("concept-track");
  const carousel = document.getElementById("concept-carousel");
  const prevBtn = document.getElementById("concept-prev") as HTMLButtonElement | null;
  const nextBtn = document.getElementById("concept-next") as HTMLButtonElement | null;
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".concept-dot"));
  const slideCount = dots.length;
  let index = 0;

  const render = () => {
    if (track) track.style.transform = `translateX(-${index * 100}%)`;
    dots.forEach((dot, i) => dot.setAttribute("aria-selected", String(i === index)));
  };

  const goTo = (next: number) => {
    index = (next + slideCount) % slideCount;
    render();
  };

  prevBtn?.addEventListener("click", () => goTo(index - 1));
  nextBtn?.addEventListener("click", () => goTo(index + 1));

  dots.forEach((dot, i) => {
    dot.addEventListener("click", () => goTo(i));
  });

  const dotsContainer = document.getElementById("concept-dots");

  document.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
    const active = document.activeElement;
    if (!active) return;
    if (!carousel?.contains(active) && !dotsContainer?.contains(active)) return;

    e.preventDefault();
    if (e.key === "ArrowLeft") goTo(index - 1);
    if (e.key === "ArrowRight") goTo(index + 1);
  });

  document.querySelectorAll<HTMLButtonElement>(".concept-cta-secondary").forEach((btn) => {
    btn.addEventListener("click", () => {
      const businessType = btn.dataset.businessType || "";

      const notice = document.getElementById("prefill-notice");
      const typeEl = document.getElementById("prefill-type");
      const serviceSelect = document.getElementById("service") as HTMLSelectElement | null;
      const businessNameInput = document.getElementById("business_name") as HTMLInputElement | null;

      if (typeEl) typeEl.textContent = businessType;
      if (notice) notice.hidden = false;

      if (serviceSelect) {
        serviceSelect.value = "New Site";
        serviceSelect.dispatchEvent(new Event("change"));
      }

      document.getElementById("contact")?.scrollIntoView({ behavior: "smooth", block: "start" });

      if (businessNameInput && !businessNameInput.value) {
        window.setTimeout(() => businessNameInput.focus(), 500);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".viewport-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const frame = btn.closest<HTMLElement>("[data-preview-frame]");
      if (!frame) return;
      const mode = btn.dataset.mode;
      const siblingBtns = frame.querySelectorAll<HTMLButtonElement>(".viewport-btn");

      siblingBtns.forEach((sibling) => {
        const isActive = sibling === btn;
        sibling.classList.toggle("is-active", isActive);
        sibling.setAttribute("aria-pressed", String(isActive));
      });

      frame.classList.toggle("is-mobile-view", mode === "mobile");
    });
  });
</script>
