---
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const concepts = [
  {
    category: "Salon & wellness",
    business: "Aura Skin & Beauty",
    preview: `${base}/previews/salon-preview.webp`,
    href: `${base}/demo-salon.html`,
    description: "Sticky booking bar, visual price list, treatment pages built for local search.",
    chips: ["Sticky booking", "Visual pricing"],
  },
  {
    category: "Trade & services",
    business: "Apex Heating & Electrical",
    preview: `${base}/previews/trade-preview.webp`,
    href: `${base}/demo-trade.html`,
    description: "Tap-to-call in the header, 24/7 callout badge, and a page that loads on a job site.",
    chips: ["Tap-to-call", "Fast load"],
  },
  {
    category: "Café & restaurant",
    business: "The Artisan Kitchen",
    preview: `${base}/previews/cafe-preview.webp`,
    href: `${base}/demo-cafe.html`,
    description: "Open-now status, tabbed menu you can edit, and instant table booking.",
    chips: ["Live status", "Tabbed menu"],
  },
];
---

<section class="section section-alt" id="work">
  <div class="wrap">
    <div class="work-head reveal">
      <div class="work-head-copy">
        <span class="eyebrow">What we build</span>
        <h2>See the kind of site we'd build for you.</h2>
        <p>Full concept builds we designed to show what your site could be. Pick the one closest to your business and we'll start there.</p>
      </div>
      <span class="pill concept-note">
        <Icon name="info" class="concept-note-icon" />
        Concept demos — our own work, not client sites
      </span>
    </div>

    <div class="work-grid reveal-stagger">
      {concepts.map((concept) => (
        <article class="work-card card">
          <img
            src={concept.preview}
            alt={`${concept.business} concept site`}
            width="1120"
            height="680"
            loading="lazy"
            class="work-card-img"
          />
          <div class="work-card-body">
            <div>
              <span class="work-card-category">{concept.category}</span>
              <h3>{concept.business}</h3>
            </div>
            <p class="work-card-desc">{concept.description}</p>
            <div class="work-card-chips">
              {concept.chips.map((chip) => (
                <span class="work-chip">{chip}</span>
              ))}
            </div>
            <a href={concept.href} target="_blank" rel="noopener" class="arrow-link">
              View the demo
              <Icon name="external-link" class="arrow-link-icon" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 44px;
  }

  .work-head-copy {
    max-width: 600px;
  }

  .work-head-copy h2 {
    margin: 0 0 14px;
  }

  .work-head-copy p {
    color: rgba(28, 23, 16, 0.72);
    font-size: 1.02rem;
    margin: 0;
    max-width: 52ch;
  }

  .concept-note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    background: var(--bg);
    border: 1px solid rgba(28, 23, 16, 0.18);
    color: rgba(28, 23, 16, 0.7);
    font-size: 0.78rem;
  }

  .concept-note-icon {
    width: 14px;
    height: 14px;
    color: var(--accent-text);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 22px;
  }

  .work-card {
    background: var(--bg);
    border: 1px solid rgba(28, 23, 16, 0.12);
    border-radius: 20px;
    overflow: hidden;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .work-card-img {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 1px solid rgba(28, 23, 16, 0.1);
  }

  .work-card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .work-card-category {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .work-card-body h3 {
    font-size: 1.24rem;
    line-height: 1.15;
    margin: 6px 0 0;
    letter-spacing: -0.01em;
  }

  .work-card-desc {
    margin: 0;
    font-size: 0.9rem;
    color: rgba(28, 23, 16, 0.7);
  }

  .work-card-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: auto;
  }

  .work-chip {
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(28, 23, 16, 0.7);
  }

  .arrow-link-icon {
    width: 14px;
    height: 14px;
  }
</style>
