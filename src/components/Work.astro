---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const concepts = [
  {
    tag: "Trade & Services Concept",
    business: "Apex Heating & Electrical",
    preview: `${base}/previews/trade-preview.jpg`,
    href: `${base}/demo-trade.html`,
    features: ["Tap-to-call enabled", "24/7 emergency badge", "0.6s load speed"],
    businessType: "Trade & Services",
  },
  {
    tag: "Café & Restaurant Concept",
    business: "The Artisan Kitchen",
    preview: `${base}/previews/cafe-preview.jpg`,
    href: `${base}/demo-cafe.html`,
    features: ["Live open/closed status", "Tabbed menu system", "Instant table booking"],
    businessType: "Café & Restaurant",
  },
  {
    tag: "Salon & Wellness Concept",
    business: "Aura Skin & Beauty",
    preview: `${base}/previews/salon-preview.jpg`,
    href: `${base}/demo-salon.html`,
    features: ["Sticky booking bar", "Visual pricing menu", "Client review slider"],
    businessType: "Salon & Wellness",
  },
];
---

<section class="section" id="work">
  <div class="wrap work-wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Our work</span>
      <h2>No client sites yet — here's what we'd build you.</h2>
      <p>
        We're a new studio, so there's no real portfolio to show off yet.
        Here's one of the concept builds we'd design for a business like
        yours — flick through to see the others.
      </p>
    </div>

    <div class="concept-carousel reveal" id="concept-carousel">
      <button type="button" class="carousel-arrow carousel-arrow--prev" id="concept-prev" aria-label="Previous concept">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <div class="concept-viewport">
        <div class="concept-track" id="concept-track">
          {concepts.map((concept) => (
            <div class="concept-slide">
              <div class="concept-card">
                <div class="preview-frame">
                  <div class="browser-bar">
                    <span></span><span></span><span></span>
                  </div>
                  <div class="preview-image-wrap">
                    <img
                      src={concept.preview}
                      alt={`${concept.business} homepage preview`}
                      loading="lazy"
                      width="1120"
                      height="680"
                    />
                    <div class="device-badges">
                      <span class="device-badge">
                        <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                        Desktop
                      </span>
                      <span class="device-badge">
                        <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>
                        Mobile
                      </span>
                    </div>
                  </div>
                </div>

                <span class="pill concept-tag">{concept.tag}</span>

                <ul class="feature-tags">
                  {concept.features.map((feature) => (
                    <li>
                      <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      {feature}
                    </li>
                  ))}
                </ul>

                <div class="concept-ctas">
                  <a href={concept.href} target="_blank" rel="noopener" class="btn btn-primary concept-cta-primary">
                    View Demo
                    <svg class="cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
                  </a>
                  <button type="button" class="btn btn-ghost concept-cta-secondary" data-business-type={concept.businessType}>
                    Want a site like this?
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <button type="button" class="carousel-arrow carousel-arrow--next" id="concept-next" aria-label="Next concept">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>

    <div class="concept-dots" id="concept-dots" role="tablist" aria-label="Choose a concept">
      {concepts.map((concept, i) => (
        <button
          type="button"
          class="concept-dot"
          data-index={i}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-label={`Show ${concept.business} concept`}
        ></button>
      ))}
    </div>

    <div class="founding-note reveal">
      <p>
        Like the direction? The first businesses we work with get priority
        turnaround and founder pricing — and a real say in how it turns out.
      </p>
      <a href="#contact" class="btn btn-primary">Become a founding client</a>
    </div>
  </div>
</section>

<style>
  .concept-carousel {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  .carousel-arrow {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--line-strong);
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: var(--shadow);
    transition: border-color 0.25s ease, color 0.25s ease, transform 0.25s var(--ease);
  }

  .carousel-arrow:hover {
    border-color: var(--accent-2);
    color: var(--accent-2);
  }

  .carousel-arrow:active {
    transform: scale(0.94);
  }

  .carousel-arrow svg {
    width: 18px;
    height: 18px;
  }

  .concept-viewport {
    flex: 1;
    max-width: 640px;
    margin: 0 auto;
    overflow: hidden;
  }

  .concept-track {
    display: flex;
    transition: transform 0.5s var(--ease);
  }

  .concept-slide {
    flex: 0 0 100%;
    width: 100%;
  }

  .concept-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .preview-frame {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .browser-bar {
    background: #0f172a;
    padding: 8px;
    display: flex;
    gap: 6px;
  }

  .browser-bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
  }

  .browser-bar span:first-child { background: #ff5f56; }
  .browser-bar span:nth-child(2) { background: #ffbd2e; }
  .browser-bar span:nth-child(3) { background: #27c93f; }

  .preview-image-wrap {
    position: relative;
    line-height: 0;
  }

  .preview-image-wrap img {
    width: 100%;
    height: auto;
    display: block;
  }

  .device-badges {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: flex;
    gap: 6px;
  }

  .device-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(11, 14, 20, 0.72);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 5px 10px;
    border-radius: 999px;
  }

  .badge-icon { width: 12px; height: 12px; }

  .concept-tag { align-self: flex-start; }

  .feature-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .feature-tags li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--text-dim);
  }

  .feature-icon {
    width: 15px;
    height: 15px;
    color: var(--accent-2);
    flex-shrink: 0;
  }

  .concept-ctas {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .concept-cta-primary {
    width: 100%;
  }

  .cta-icon {
    width: 15px;
    height: 15px;
  }

  .concept-cta-secondary {
    width: 100%;
    font-size: 0.86rem;
  }

  .concept-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 48px;
  }

  .concept-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .concept-dot:hover {
    background: var(--accent-2);
  }

  .concept-dot[aria-selected="true"] {
    background: var(--accent);
    transform: scale(1.3);
  }

  .founding-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: 32px;
  }

  .founding-note p {
    margin: 0;
    color: var(--text-dim);
    max-width: 480px;
  }

  @media (max-width: 640px) {
    .concept-carousel {
      gap: 10px;
    }
    .carousel-arrow {
      width: 38px;
      height: 38px;
    }
  }
</style>

<script>
  const track = document.getElementById("concept-track");
  const carousel = document.getElementById("concept-carousel");
  const prevBtn = document.getElementById("concept-prev") as HTMLButtonElement | null;
  const nextBtn = document.getElementById("concept-next") as HTMLButtonElement | null;
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".concept-dot"));
  const slideCount = dots.length;
  let index = 0;

  const render = () => {
    if (track) track.style.transform = `translateX(-${index * 100}%)`;
    dots.forEach((dot, i) => dot.setAttribute("aria-selected", String(i === index)));
  };

  const goTo = (next: number) => {
    index = (next + slideCount) % slideCount;
    render();
  };

  prevBtn?.addEventListener("click", () => goTo(index - 1));
  nextBtn?.addEventListener("click", () => goTo(index + 1));

  dots.forEach((dot, i) => {
    dot.addEventListener("click", () => goTo(i));
  });

  const dotsContainer = document.getElementById("concept-dots");

  document.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
    const active = document.activeElement;
    if (!active) return;
    if (!carousel?.contains(active) && !dotsContainer?.contains(active)) return;

    e.preventDefault();
    if (e.key === "ArrowLeft") goTo(index - 1);
    if (e.key === "ArrowRight") goTo(index + 1);
  });

  document.querySelectorAll<HTMLButtonElement>(".concept-cta-secondary").forEach((btn) => {
    btn.addEventListener("click", () => {
      const businessType = btn.dataset.businessType || "";

      const notice = document.getElementById("prefill-notice");
      const typeEl = document.getElementById("prefill-type");
      const serviceSelect = document.getElementById("service") as HTMLSelectElement | null;
      const businessNameInput = document.getElementById("business_name") as HTMLInputElement | null;

      if (typeEl) typeEl.textContent = businessType;
      if (notice) notice.hidden = false;

      if (serviceSelect) {
        serviceSelect.value = "New Site";
        serviceSelect.dispatchEvent(new Event("change"));
      }

      document.getElementById("contact")?.scrollIntoView({ behavior: "smooth", block: "start" });

      if (businessNameInput && !businessNameInput.value) {
        window.setTimeout(() => businessNameInput.focus(), 500);
      }
    });
  });
</script>
