---
interface Props {
  class?: string;
  color?: string;
}

const { class: className = "", color = "currentColor" } = Astro.props;
---

<span class={className} style={`color: ${color}`} aria-hidden="true">CGD</span>

<style>
  span {
    font-family: "EB Garamond", serif;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }
</style>
