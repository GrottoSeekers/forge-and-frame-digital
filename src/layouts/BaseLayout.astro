---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Forge & Frame Digital — Websites for local businesses",
  description = "We design and build fast, modern websites for local businesses across the UK — whether you don't have one yet or your current site needs an upgrade.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="scroll-progress"></div>
    <slot />
    <script>
      const bar = document.getElementById("scroll-progress");

      function updateProgress() {
        const scrollTop = window.scrollY;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const pct = height > 0 ? (scrollTop / height) * 100 : 0;
        if (bar) bar.style.width = `${pct}%`;
      }

      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();

      const revealTargets = document.querySelectorAll(".reveal, .reveal-stagger");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
      );
      revealTargets.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
